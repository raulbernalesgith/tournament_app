{
  "name": "tournament-app",
  "version": "0.1.0",
  "private": true,
  "description": "Table tennis tournament app: groups and knockout brackets synced from a Google Sheet, served by a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "build:client": "node build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/app/tsconfig.json",
    "snapshot": "python3 scripts/xlsx_to_grids.py"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
