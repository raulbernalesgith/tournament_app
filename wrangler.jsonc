{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tournament-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // Builds the web app into dist/client before every `wrangler dev` / `wrangler deploy`.
  "build": {
    "command": "npm run build:client"
  },

  // The web app is served as static assets; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The sheet's tabs as last downloaded (written only when they change, at most every 2 minutes),
  // the tab list, and the sync status. The app builds groups and brackets in the browser.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d1016fdad5b746eba5487d8e3d985849"
    }
  ],

  // Download the sheet's tabs once a minute; re-read the tab list (new event tabs) every 10 minutes.
  // The second cron must match DISCOVER_CRON in src/worker/index.ts.
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *"]
  },

  "observability": {
    "enabled": true
  }

  // Secrets (set in the Cloudflare dashboard or with `wrangler secret put`):
  //   SHEET_ID        The id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
  //   GOOGLE_API_KEY  Google Cloud API key restricted to the Google Sheets API (recommended)
  //   SHEET_TABS      Optional, instead of an API key: "Canada_Rankings=0,Open_Singles=123,..." (tab=gid pairs)
}
